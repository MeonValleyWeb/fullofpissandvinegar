---
const title = "Full of Piss and Vinegar";
const description = "Football banter, sarcasm, and wit - no filters, no apologies";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<style>
			:root {
				--pv-green: #00a651;
				--pv-dark-green: #008c44;
				--pv-yellow: #d4ff00;
				--pv-lime: #ccff00;
				--pv-beige: #d4b896;
				--pv-tan: #c9a86c;
				--pv-black: #1a1a1a;
				--pv-white: #ffffff;
			}
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			body {
				font-family: 'Impact', 'Arial Black', 'Helvetica Neue', sans-serif;
				background: var(--pv-green);
				color: var(--pv-black);
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				overflow-x: hidden;
			}
			.container {
				text-align: center;
				padding: 2rem;
				max-width: 900px;
			}
			.logo {
				font-size: clamp(3rem, 10vw, 6rem);
				font-weight: 900;
				letter-spacing: -2px;
				margin-bottom: 0.5rem;
				text-transform: uppercase;
				line-height: 0.9;
			}
			.logo-top {
				background: var(--pv-black);
				color: var(--pv-white);
				padding: 0.2rem 1rem;
				display: inline-block;
				transform: skew(-5deg);
			}
			.logo-middle {
				color: var(--pv-lime);
				text-shadow: 4px 4px 0 var(--pv-black);
				font-size: 1.3em;
				display: block;
			}
			.logo-small {
				color: var(--pv-white);
				font-size: 0.4em;
				vertical-align: middle;
				background: var(--pv-black);
				padding: 0.1rem 0.3rem;
				display: inline-block;
				transform: rotate(-5deg);
			}
			.logo-bottom {
				color: var(--pv-tan);
				text-shadow: 3px 3px 0 var(--pv-black);
				font-size: 0.9em;
				display: block;
			}
			.tagline {
				font-size: 1.4rem;
				color: var(--pv-black);
				margin-bottom: 2rem;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 2px;
				background: var(--pv-yellow);
				padding: 0.5rem 1rem;
				display: inline-block;
				transform: rotate(-2deg);
			}
			.banter-quote {
				font-size: 1.2rem;
				color: var(--pv-black);
				font-style: italic;
				margin: 2rem auto;
				font-family: 'Georgia', serif;
				background: var(--pv-white);
				padding: 1rem 1.5rem;
				border-left: 6px solid var(--pv-black);
				max-width: 600px;
				transform: rotate(1deg);
				box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
			}
			.coming-soon {
				background: var(--pv-black);
				color: var(--pv-lime);
				padding: 1.2rem 3rem;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 3px;
				display: inline-block;
				font-size: 1.3rem;
				transform: skew(-5deg);
				transition: all 0.3s ease;
				border: 4px solid var(--pv-yellow);
			}
			.coming-soon:hover {
				transform: skew(0deg) scale(1.05);
				color: var(--pv-yellow);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-top: 4rem;
				width: 100%;
			}
			.card {
				background: var(--pv-black);
				padding: 2rem;
				border: 4px solid var(--pv-yellow);
				color: var(--pv-white);
				transform: rotate(-1deg);
				transition: transform 0.3s ease;
			}
			.card:hover {
				transform: rotate(0deg) scale(1.02);
			}
			.card h3 {
				color: var(--pv-lime);
				margin-bottom: 1rem;
				font-size: 1.4rem;
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.card p {
				color: #ccc;
				font-size: 1rem;
				font-family: 'Helvetica Neue', Arial, sans-serif;
				font-weight: 400;
			}
			footer {
				margin-top: 4rem;
				color: var(--pv-black);
				font-size: 0.9rem;
				text-transform: uppercase;
				letter-spacing: 2px;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<div class="container">
			<div class="logo">
				<span class="logo-top">FULL OF</span>
				<span class="logo-middle">PISS<span class="logo-small">AND</span></span>
				<span class="logo-bottom">VINEGAR</span>
			</div>
			
			<p class="tagline">Football Banter • Sarcasm • Wit</p>
			
			<p class="banter-quote">"We're not here to make friends, we're here to take the piss... professionally."</p>
			
			<div class="coming-soon">Coming Soon</div>
			
			<div class="grid">
				<div class="card">
					<h3>⚽ Matchday Banter</h3>
					<p>Unfiltered takes on the beautiful game</p>
				</div>
				<div class="card">
					<h3>🎭 Zero Chill</h3>
					<p>Sarcasm level: Expert. Tact: None.</p>
				</div>
				<div class="card">
					<h3>🍺 Proper Wit</h3>
					<p>Like the pub, but you can't punch us</p>
				</div>
			</div>
			
			<footer>
				Built with Astro • Deployed on Cloudflare Pages
			</footer>
		</div>
	</body>
</html>