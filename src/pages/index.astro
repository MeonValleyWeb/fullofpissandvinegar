---
const title = "Full of Piss and Vinegar";
const description = "Football banter, sarcasm, and wit - you know you've got to let it out!";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}
			body {
				font-family: 'Impact', 'Arial Black', 'Franklin Gothic', sans-serif;
				background: #e8e8e8;
				color: #1a1a2e;
				min-height: 100vh;
				overflow-x: hidden;
			}
			.hero {
				width: 100%;
				min-height: 100vh;
				background: url('/hero.jpg') center top / cover no-repeat;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: flex-start;
				padding-top: 2rem;
				position: relative;
			}
			.container {
				text-align: center;
				padding: 2rem;
				max-width: 900px;
				z-index: 2;
			}
			.logo-img {
				max-width: 100%;
				width: 500px;
				height: auto;
				margin-bottom: 2rem;
				filter: drop-shadow(4px 4px 8px rgba(0,0,0,0.3));
			}
			.tagline {
				font-size: 1.5rem;
				color: #1a1a2e;
				margin: 1rem 0 2rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 2px;
				text-shadow: 1px 1px 0 rgba(255,255,255,0.5);
			}
			.banter-quote {
				font-size: 1.2rem;
				color: #2a2a3a;
				font-style: italic;
				margin: 2rem auto;
				font-family: 'Georgia', serif;
				max-width: 600px;
				padding: 1rem 1.5rem;
				background: rgba(255,255,255,0.9);
				border-left: 4px solid #c8e600;
				box-shadow: 3px 3px 0 rgba(0,0,0,0.1);
			}
			.coming-soon {
				background: #1a1a2e;
				color: #c8e600;
				padding: 1.2rem 3rem;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 4px;
				display: inline-block;
				font-size: 1.2rem;
				margin-top: 1rem;
				box-shadow: 4px 4px 0 rgba(0,0,0,0.2);
				transition: all 0.3s ease;
			}
			.coming-soon:hover {
				transform: translate(-2px, -2px);
				box-shadow: 6px 6px 0 rgba(0,0,0,0.3);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
				margin-top: 3rem;
				margin-bottom: 100px;
				width: 100%;
			}
			.card {
				background: white;
				padding: 2rem;
				border: 3px solid #1a1a2e;
				color: #1a1a2e;
				box-shadow: 5px 5px 0 #c8e600;
				transition: all 0.3s ease;
			}
			.card:hover {
				transform: translate(-3px, -3px);
				box-shadow: 8px 8px 0 #c8e600;
			}
			.card h3 {
				color: #1a1a2e;
				margin-bottom: 1rem;
				font-size: 1.3rem;
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.card p {
				color: #444;
				font-size: 1rem;
				font-family: 'Helvetica Neue', Arial, sans-serif;
			}
			footer {
				margin-top: 2rem;
				padding: 1.5rem;
				background: #1a1a2e;
				color: white;
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 2px;
				font-weight: 600;
				text-align: center;
				width: 100%;
			}
		</style>
	</head>
	<body>
		<div class="hero">
			<div class="container">
				<img src="/hero.jpg" alt="Full of Piss and Vinegar" class="logo-img" />
				
				<p class="banter-quote">"We're not here to make friends, we're here to take the piss... professionally."</p>
				
				<div class="coming-soon">Coming Soon</div>
				
				<div class="grid">
					<div class="card">
						<h3>⚽ Matchday Banter</h3>
						<p>Unfiltered takes on the beautiful game</p>
					</div>
					<div class="card">
						<h3>🎭 Zero Chill</h3>
						<p>Sarcasm level: Expert. Tact: None.</p>
					</div>
					<div class="card">
						<h3>🍺 Proper Wit</h3>
						<p>Like the pub, but you can't punch us</p>
					</div>
				</div>
			</div>
		</div>
		
		<footer>
			Built with Astro • Deployed on Cloudflare Pages
		</footer>
	</body>
</html>